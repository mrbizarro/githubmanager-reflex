# GitHub Issues Manager Configuration Template
# Copy this file to .env and fill in your values

# GitHub Settings (Required)
GITHUB_TOKEN=your_github_token_here
REPO_OWNER=your_username_or_org
REPO_NAME=your_repository_name

# DeepSeek AI Settings (Optional - enables AI-powered parsing)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Application Settings
ENVIRONMENT=production
THEME=dark

# Instructions:
# 1. Copy this file to .env
# 2. Get GitHub token from: https://github.com/settings/tokens
#    - Select "Generate new token (classic)"
#    - Check "repo" scope for full repository access
# 3. Get DeepSeek API key from: https://platform.deepseek.com/
#    - Optional but enables AI features
# 4. Set your repository owner (username/org) and name
# 5. Save the file and restart the application
