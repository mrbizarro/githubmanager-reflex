# ==============================================================================
# Additional safety patterns
# ==============================================================================

# Anything with 'secret', 'private', 'key' in the name
*secret*
*private*
*confidential*

# Backup files
*.bak
*.backup
*~

# Lock files
*.lock

# Node.js (in case you add any frontend tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# WHITELIST - Force include important files that might be ignored
# ==============================================================================

# Force include these important files even if they match ignore patterns
!requirements.txt
!.env.template
!.env.example
!README.md
!LICENSE
!.gitignore
