# ==============================================================================
# SECURITY - Never commit sensitive information
# ==============================================================================

# Environment variables and secrets
.env
.env.local
.env.production
.env.staging
.env.development
*.key
*.pem
*.p12
*.pfx
config.ini
secrets.json
credentials.json

# API Keys and tokens (extra protection)
*key*
*token*
*secret*
*password*
*credential*

# ==============================================================================
# Python
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
