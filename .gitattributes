# ==============================================================================
# Git Attributes Configuration
# ==============================================================================

# Set default behavior to automatically normalize line endings
* text=auto

# ==============================================================================
# Source Code Files
# ==============================================================================

# Python files
*.py text eol=lf
*.pyw text eol=lf
*.pyi text eol=lf

# Configuration files
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Batch files (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# ==============================================================================
# Binary Files (never auto-convert)
# ==============================================================================

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Archives
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.rar binary

# Executables
*.exe binary
*.dll binary

# ==============================================================================
# Git LFS (Large File Storage) - if needed
# ==============================================================================

# Uncomment if you plan to use Git LFS for large files
# *.zip filter=lfs diff=lfs merge=lfs -text
# *.7z filter=lfs diff=lfs merge=lfs -text
# *.tar.gz filter=lfs diff=lfs merge=lfs -text

# ==============================================================================
# GitHub Language Detection
# ==============================================================================

# Help GitHub correctly identify the repository language
*.py linguist-language=Python
*.md linguist-documentation
.env.template linguist-language=Shell

# Don't count certain files in language statistics
*.json linguist-generated=true
venv/* linguist-vendored
__pycache__/* linguist-generated=true
